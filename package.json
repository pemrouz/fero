{
  "name": "fero",
  "version": "0.0.0",
  "description": "distributed, replicated reactive resources — fero(name, opts) on top of `data`",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./internals": "./internals.ts"
  },
  "imports": {
    "#utils": "./utils/index.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test-concurrency=1 --test \"utils/*.test.ts\" \"transport/*.test.ts\" \"log/*.test.ts\" \"resource/*.test.ts\" \"tools/*.test.ts\" \"tools/observe/*.test.ts\" \"tests/chaos/*.test.ts\"",
    "perf": "node --experimental-strip-types --no-warnings --test-concurrency=1 --test \"transport/*.perf.ts\" \"log/*.perf.ts\" \"resource/*.perf.ts\" \"tools/observe/*.perf.ts\"",
    "readable": "node --experimental-strip-types --no-warnings tools/readable.ts",
    "observe": "node --experimental-strip-types --no-warnings tools/observe/index.ts"
  },
  "author": "pemrouz",
  "license": "MIT"
}
